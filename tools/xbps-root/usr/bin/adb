#!/bin/sh
set -eu

# Compatibility shim for callers that historically hard-coded this path.
# Prefer a host-installed adb so we share the host adb server/key state.
# Fall back to the packaged XBPS binary only when no other adb is available.

self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
self="$self_dir/adb"
bundled="$self_dir/adb.xbps"
lib_dir=$(CDPATH= cd -- "$self_dir/../lib" && pwd)
self_real=$(readlink -f "$self" 2>/dev/null || printf '%s\n' "$self")

exec_host_adb() {
    host_adb=$1
    shift

    # Older scripts put the XBPS library directory in LD_LIBRARY_PATH before
    # invoking this path. Do not leak those libraries into a distro adb.
    clean_ld=""
    old_ifs=$IFS
    IFS=:
    for entry in ${LD_LIBRARY_PATH:-}; do
        [ -n "$entry" ] || continue
        entry_real=$(CDPATH= cd -- "$entry" 2>/dev/null && pwd || printf '%s\n' "$entry")
        [ "$entry_real" = "$lib_dir" ] && continue
        clean_ld="${clean_ld:+$clean_ld:}$entry"
    done
    IFS=$old_ifs

    if [ -n "$clean_ld" ]; then
        export LD_LIBRARY_PATH="$clean_ld"
    else
        unset LD_LIBRARY_PATH
    fi
    exec "$host_adb" "$@"
}

# Respect an explicitly exported ADB path when it is not this shim.
if [ -n "${ADB:-}" ]; then
    case "$ADB" in
        */*)
            adb_real=$(readlink -f "$ADB" 2>/dev/null || printf '%s\n' "$ADB")
            if [ "$adb_real" != "$self_real" ] && [ -x "$ADB" ]; then
                exec_host_adb "$ADB" "$@"
            fi
            ;;
    esac
fi

# Search PATH manually so this shim can skip itself even when its directory was
# prepended by older SnuSnuRoot scripts.
old_ifs=$IFS
IFS=:
for dir in ${PATH:-}; do
    [ -n "$dir" ] || dir=.
    candidate="$dir/adb"
    [ -x "$candidate" ] || continue
    candidate_real=$(readlink -f "$candidate" 2>/dev/null || printf '%s\n' "$candidate")
    [ "$candidate_real" = "$self_real" ] && continue
    IFS=$old_ifs
    exec_host_adb "$candidate" "$@"
done
IFS=$old_ifs

[ -x "$bundled" ] || {
    echo "adb: no system adb found and bundled fallback is missing: $bundled" >&2
    exit 127
}

export LD_LIBRARY_PATH="$lib_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$bundled" "$@"
